<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest is the "table of contents" for the whole app — Android reads this
  file BEFORE running any of your code to find out what components (screens,
  broadcast receivers) exist, what permissions the app needs, and how the OS
  should launch/route to each piece.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET             — required to call the Open-Meteo forecast API
                              (see WeatherClient.kt).
      ACCESS_NETWORK_STATE  — lets the app check general connectivity info.
      ACCESS_COARSE_LOCATION — city/neighborhood-level location, resolved via
                              the network provider. Deliberately NOT requesting
                              ACCESS_FINE_LOCATION: a weather forecast doesn't
                              need GPS-grade precision, so we ask for the least
                              invasive permission that gets the job done.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      "Allow all the time" location. The widgets' 12 AM / 12 PM update runs with the
      app closed, and Android only gives a closed app a location with this. Without it
      the "Current" widget sticks to wherever the app was last opened.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!--
      Exact alarms for the widgets' 12 AM / 12 PM update (WidgetRefreshScheduler.kt),
      so it lands on the minute instead of drifting under Doze.
      USE_EXACT_ALARM is granted at install on Android 13+; SCHEDULE_EXACT_ALARM covers 12.
      RECEIVE_BOOT_COMPLETED re-books the alarm after a restart, since reboots clear alarms.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeatherWidget">

        <!--
          The screen either widget opens when tapped: full weather detail,
          plus the location-permission prompt when needed. The MAIN/LAUNCHER
          intent-filter is also what makes this show up in the app drawer.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WeatherWidget">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Shown automatically right after a new widget is dragged onto the home
          screen (wired up via weather_widget_info.xml's android:configure
          attribute) — lets you pick which location THIS widget instance shows.
          android:exported="true" is required for configuration activities: the
          launcher/system UI itself is the one that starts it.
        -->
        <activity
            android:name=".WeatherWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.WeatherWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
          The widget's brain (see WeatherWidgetProvider.kt). exported="false"
          means only broadcasts from our own app process reach it directly
          (the OS itself is always allowed to deliver the standard widget
          lifecycle broadcasts regardless of this flag).
            - APPWIDGET_UPDATE is the standard system broadcast.
            - com.weatherwidget.app.ACTION_REFRESH is OUR OWN broadcast, fired
              only when the widget's ↻ is tapped. The only timed update is the
              12 AM / 12 PM one (ScheduledRefreshReceiver below); updatePeriodMillis="0".
        -->
        <receiver
            android:name=".WeatherWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.weatherwidget.app.ACTION_REFRESH" />
                <!-- Repaint all widgets from cache after an app update (see onReceive). -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>

        <!-- The 4x2 "Weather Donkey Wide" widget — same behavior as above (it subclasses
             WeatherWidgetProvider), just its own size and layout. -->
        <receiver
            android:name=".WeatherWideWidgetProvider"
            android:label="@string/widget_label_wide"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_wide_widget_info" />
        </receiver>

        <!--
          The widgets' 12 AM / 12 PM update (WidgetRefreshScheduler.kt). It gets our own
          exact alarm, plus the system broadcasts that clear the alarm or move "midnight":
          reboot, clock change, timezone change, date rollover, app update. Those
          system actions are exempt from Android 8's implicit-broadcast limits, the same
          way the Today Calendar widget's DateChangeReceiver works.
        -->
        <receiver
            android:name=".ScheduledRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.weatherwidget.app.ACTION_SCHEDULED_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
