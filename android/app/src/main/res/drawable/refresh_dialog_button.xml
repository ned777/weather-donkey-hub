<?xml version="1.0" encoding="utf-8"?>
<!-- A choice button inside the "Update from…" popup: black with a thin pink outline,
     filled pink-tinted while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55FF10F0" />
            <stroke android:width="2dp" android:color="@color/neon_pink" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
            <stroke android:width="2dp" android:color="@color/neon_pink" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
