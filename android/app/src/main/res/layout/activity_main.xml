<?xml version="1.0" encoding="utf-8"?>
<!--
  MainActivity's screen, laid out like the web page: a compact header, the
  location tabs, then cards — Right Now (source chips, temperature beside the
  condition, an 8-box details grid, sunrise/sunset bar), Next 12 Hours, 5-Day
  Forecast, What Was the Weather?, and the °F ⇄ °C converter.
  Refreshing is swipe-down only (SwipeRefreshLayout) — nothing fetches on its
  own on launch/resume, matching the widget's tap-only rule (see MainActivity.kt).
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="24dp">

            <!-- ===== Header: logo + name on the left, °F/°C on the right ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_launcher_foreground" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_title"
                        android:textColor="@color/retro_yellow"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_subtitle"
                        android:textColor="@color/app_dim"
                        android:textSize="11sp"
                        android:textStyle="bold|italic" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/app_seg"
                    android:orientation="horizontal"
                    android:padding="1dp">

                    <TextView
                        android:id="@+id/fahrenheitButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="@string/unit_fahrenheit"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/celsiusButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="@string/unit_celsius"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- One tab per location: "Current" (GPS) + saved cities, plus a "+" tab that
                 opens the search dialog — see MainActivity.setupTabs(). Everything after
                 this view slides in when the tab changes (animateContentIn). -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                app:tabMode="scrollable"
                app:tabGravity="start"
                app:tabMinWidth="56dp"
                app:tabPaddingStart="10dp"
                app:tabPaddingEnd="10dp"
                app:tabIndicatorColor="@color/retro_cyan"
                app:tabSelectedTextColor="@color/retro_cyan"
                app:tabTextColor="@color/app_dim" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/app_line" />

            <!-- ===== RIGHT NOW ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/app_card"
                android:padding="1dp"
                android:clipToOutline="true"
                android:orientation="vertical">

                <LinearLayout style="@style/CardHead">
                    <TextView style="@style/CardTitle" android:text="@string/now_header" />
                    <TextView
                        android:id="@+id/placeText"
                        style="@style/CardMeta" />
                </LinearLayout>
                <View style="@style/Line" />

                <!-- Average / Open-Meteo / MET Norway / 7Timer! — filled in by renderSourceChips() -->
                <HorizontalScrollView
                    android:id="@+id/sourceScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/sourceChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />
                </HorizontalScrollView>
                <View style="@style/Line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/todayLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_today_label"
                            android:textColor="@color/retro_teal"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <!-- Outlined; sized in MainActivity.applyTempTextSize() to fill this column. -->
                        <com.weatherwidget.app.OutlinedTextView
                            android:id="@+id/tempText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:textColor="@color/retro_cyan"
                            android:textSize="100sp"
                            android:textStyle="bold"
                            android:text="--°" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/conditionIcon"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_weather_cloudy" />

                            <TextView
                                android:id="@+id/conditionText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/retro_yellow"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:text="--" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/todayHighLowText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/white"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:text="H:--°  L:--°" />

                        <TextView
                            android:id="@+id/feelsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/app_dim"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4 rows × 2 boxes, built by renderStats() -->
                <LinearLayout
                    android:id="@+id/statsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Sunrise · daylight · sunset, and how far through the day it is -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/sunriseText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:text="↑ --:--" />

                        <TextView
                            android:id="@+id/dayLengthText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="@color/app_dim"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/sunsetText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:text="↓ --:--" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="4dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/app_track" />

                        <LinearLayout
                            android:id="@+id/sunTrack"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:id="@+id/sunFill"
                                android:layout_width="0dp"
                                android:layout_height="6dp"
                                android:layout_weight="0"
                                android:background="@drawable/app_fill" />

                            <View
                                android:id="@+id/sunDot"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="-6dp"
                                android:background="@drawable/app_dot" />

                            <View
                                android:id="@+id/sunRest"
                                android:layout_width="0dp"
                                android:layout_height="6dp"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <View style="@style/Line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/updatedText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/app_dim"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/removeLocationButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/app_chip"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="@string/remove_location"
                            android:textColor="@color/app_dim"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sourceLabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/app_faint"
                        android:textSize="11.5sp" />

                    <!-- Shown when a weather source was down, or the picked one didn't answer. -->
                    <TextView
                        android:id="@+id/noticeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/retro_yellow"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/grantPermissionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/app_button"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/grant_location"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Tap to switch: refresh every tab when the app is opened, or just show the last update. -->
                    <TextView
                        android:id="@+id/autoRefreshToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/app_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/app_dim"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== NEXT 12 HOURS ===== -->
            <LinearLayout
                android:id="@+id/hourlyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/app_card"
                android:padding="1dp"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/CardHead">
                    <TextView style="@style/CardTitle" android:text="@string/hourly_header" />
                    <TextView style="@style/CardMeta" android:text="@string/hourly_meta" />
                </LinearLayout>
                <View style="@style/Line" />

                <!-- MainActivity keeps swipes starting here from also changing location tabs. -->
                <HorizontalScrollView
                    android:id="@+id/hourlyScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/hourlyContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ===== 5-DAY FORECAST ===== -->
            <LinearLayout
                android:id="@+id/forecastCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/app_card"
                android:padding="1dp"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/CardHead">
                    <TextView style="@style/CardTitle" android:text="@string/forecast_header" />
                    <TextView
                        android:id="@+id/forecastMeta"
                        style="@style/CardMeta" />
                </LinearLayout>
                <View style="@style/Line" />

                <LinearLayout
                    android:id="@+id/forecastContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ===== WHAT WAS THE WEATHER? — uses whichever tab is showing ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/app_card"
                android:padding="1dp"
                android:clipToOutline="true"
                android:orientation="vertical">

                <LinearLayout style="@style/CardHead">
                    <TextView style="@style/CardTitle" android:text="@string/history_header" />
                </LinearLayout>
                <View style="@style/Line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/historyDateButton"
                            style="@style/InputBox"
                            android:layout_width="0dp"
                            android:layout_weight="1.3" />

                        <TextView
                            android:id="@+id/historyTimeButton"
                            style="@style/InputBox"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/historyLookupButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/app_button"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="@string/history_lookup"
                            android:textAllCaps="true"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/historyChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/historyMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/app_faint"
                        android:textSize="13sp"
                        android:text="@string/history_hint" />

                    <LinearLayout
                        android:id="@+id/historyResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/historyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/retro_teal"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/historyIcon"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/historyTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/retro_cyan"
                                android:textStyle="bold"
                                android:textSize="38sp" />

                            <TextView
                                android:id="@+id/historyCondition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:textColor="@color/retro_yellow"
                                android:textStyle="bold"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/historyDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/historySource"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/app_faint"
                            android:textStyle="italic"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== °F ⇄ °C — swipes starting here never change tabs ===== -->
            <LinearLayout
                android:id="@+id/converterSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/app_card"
                android:padding="1dp"
                android:clipToOutline="true"
                android:orientation="vertical">

                <LinearLayout style="@style/CardHead">
                    <TextView style="@style/CardTitle" android:text="@string/converter_header" />
                    <TextView style="@style/CardMeta" android:text="@string/converter_meta" />
                </LinearLayout>
                <View style="@style/Line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <EditText
                        android:id="@+id/fahrenheitInput"
                        style="@style/InputBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:inputType="numberSigned|numberDecimal"
                        android:hint="@string/unit_fahrenheit"
                        android:autofillHints="" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:textColor="@color/app_dim"
                        android:textSize="18sp"
                        android:text="=" />

                    <EditText
                        android:id="@+id/celsiusInput"
                        style="@style/InputBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:inputType="numberSigned|numberDecimal"
                        android:hint="@string/unit_celsius"
                        android:textColor="@color/retro_yellow"
                        android:autofillHints="" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
