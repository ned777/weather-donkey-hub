<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4x2 "Weather Donkey Wide" widget. Same data, location binding, refresh
  and caching as the 2x2 widget (it's a subclass of WeatherWidgetProvider; see
  WeatherWideWidgetProvider and buildWideViews()), laid out for a wide card:

    ↻                   CARSON
    65°   Cloudy                  | Feels       62°
                  H:69°  L:62°      | Rain        20%
                                    | Wind     8 NW
                                    | Humidity    54%
    ─────────────────────────────────────────────────
    WED   THU   FRI   SAT   SUN  |  ↑ 06:25
    65°   65°   64°   ...        |  ↓ 16:49
    57°   61°   56°   ... (low, dimmed)
    Server update 23:19 · Nov 15 · PST

  Tapping ↻ (top-left) reloads it from the server; the rest of the card opens the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weatherWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background_r26_inset"
    android:paddingTop="8dp"
    android:paddingBottom="10dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Header: a big ↻ refresh icon top-left (reloads from the server) in a 48x44dp
         fingertip-sized tap box, the city name centered, and a spacer on the right so the
         city stays centered. 8dp top padding + the 37dp row puts the city name the same
         distance below the border as the System Monitor widget's title. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/refreshIcon"
            android:layout_width="48dp"
            android:layout_height="37dp"
            
            android:layout_marginStart="-10dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/retro_cyan"
            android:textStyle="bold"
            android:textSize="30sp"
            android:text="↻" />
        <TextView
            android:id="@+id/wideCityText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/retro_white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="--" />
        <TextView
            android:layout_width="38dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Hero row: temperature + condition column | details column. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Temperature + condition as one group, centered in the space left of the
             divider so there's no dead gap on either side of it. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="false">

        <TextView
            android:id="@+id/wideTempText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/retro_cyan"
            android:textStyle="bold"
            android:textSize="60sp"
            android:singleLine="true"
            android:text="--°" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wideConditionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_yellow"
                android:textStyle="bold"
                android:textSize="16sp"
                android:singleLine="true"
                android:text="--" />
            <TextView
                android:id="@+id/wideHighLowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:singleLine="true"
                android:text="H:--°  L:--°" />
        </LinearLayout>
        </LinearLayout>

        <!-- Thin teal divider. -->
        <TextView
            android:layout_width="1dp"
            android:layout_height="58dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp"
            android:background="@color/retro_teal_dim" />

        <!-- Feels / Rain / Wind / Humidity: 144dp wide with a 12dp right margin, so the
             labels sit further left, the values come in a little from the edge, and
             there's a wider gap between each label and its value. -->
        <LinearLayout
            android:layout_width="144dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/wideStat0Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/retro_teal"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:text="--" />
                <TextView
                    android:id="@+id/wideStat0Value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:gravity="end"
                    android:textColor="@color/retro_white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:text="--" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/wideStat1Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/retro_teal"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:text="--" />
                <TextView
                    android:id="@+id/wideStat1Value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:gravity="end"
                    android:textColor="@color/retro_white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:text="--" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/wideStat2Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/retro_teal"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:text="--" />
                <TextView
                    android:id="@+id/wideStat2Value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:gravity="end"
                    android:textColor="@color/retro_white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:text="--" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/wideStat3Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/retro_teal"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:text="--" />
                <TextView
                    android:id="@+id/wideStat3Value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:gravity="end"
                    android:textColor="@color/retro_white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:text="--" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Hairline above the hourly strip. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="5dp"
        android:background="@color/retro_teal_dim" />

    <!-- Next 5 days (day, high, low — no icons), then sunrise/sunset in the same row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/wideDay0Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_teal"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.06"
                android:text="--" />
            <TextView
                android:id="@+id/wideDay0High"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:singleLine="true"
                android:text="--°" />
            <TextView
                android:id="@+id/wideDay0Low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white_dim"
                android:textStyle="bold"
                android:textSize="15sp"
                android:singleLine="true"
                android:text="--°" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/wideDay1Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_teal"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.06"
                android:text="--" />
            <TextView
                android:id="@+id/wideDay1High"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:singleLine="true"
                android:text="--°" />
            <TextView
                android:id="@+id/wideDay1Low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white_dim"
                android:textStyle="bold"
                android:textSize="15sp"
                android:singleLine="true"
                android:text="--°" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/wideDay2Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_teal"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.06"
                android:text="--" />
            <TextView
                android:id="@+id/wideDay2High"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:singleLine="true"
                android:text="--°" />
            <TextView
                android:id="@+id/wideDay2Low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white_dim"
                android:textStyle="bold"
                android:textSize="15sp"
                android:singleLine="true"
                android:text="--°" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/wideDay3Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_teal"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.06"
                android:text="--" />
            <TextView
                android:id="@+id/wideDay3High"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:singleLine="true"
                android:text="--°" />
            <TextView
                android:id="@+id/wideDay3Low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white_dim"
                android:textStyle="bold"
                android:textSize="15sp"
                android:singleLine="true"
                android:text="--°" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/wideDay4Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_teal"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.06"
                android:text="--" />
            <TextView
                android:id="@+id/wideDay4High"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:singleLine="true"
                android:text="--°" />
            <TextView
                android:id="@+id/wideDay4Low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white_dim"
                android:textStyle="bold"
                android:textSize="15sp"
                android:singleLine="true"
                android:text="--°" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            android:background="@color/retro_teal_dim" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/wideSunriseText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:singleLine="true"
                android:text="↑ --:--" />
            <TextView
                android:id="@+id/wideSunsetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:singleLine="true"
                android:text="↓ --:--" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status line: "Server update <time>", "Updating from server…" mid-refresh, or an
         error. Not tappable — refreshing is the ↻ at the top-left. -->
    <TextView
        android:id="@+id/updatedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="1dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textColor="@color/retro_white_dim"
        android:textSize="10sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="" />

</LinearLayout>
