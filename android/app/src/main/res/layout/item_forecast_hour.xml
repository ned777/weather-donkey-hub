<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the 12-hour strip — filled in by MainActivity.populateHourly(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/hourLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/app_dim"
            android:textSize="12sp"
            android:text="--:--" />

        <ImageView
            android:id="@+id/conditionIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_weather_cloudy" />

        <TextView
            android:id="@+id/tempText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="--°" />

        <FrameLayout
            android:layout_width="14dp"
            android:layout_height="22dp"
            android:layout_marginTop="4dp">

            <View
                android:id="@+id/rainBar"
                android:layout_width="14dp"
                android:layout_height="0dp"
                android:layout_gravity="bottom"
                android:background="@drawable/app_rain_bar" />
        </FrameLayout>

        <TextView
            android:id="@+id/rainText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/app_faint"
            android:textSize="11sp"
            android:text="--%" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@color/app_line" />
</LinearLayout>
