<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the 5-day forecast — filled in by MainActivity.populateForecast(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/retro_teal"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="--" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_faint"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/conditionIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_weather_cloudy" />

        <TextView
            android:id="@+id/lowText"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/app_dim"
            android:textSize="13sp" />

        <!-- low…high bar, placed on the week's range with layout weights -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/app_track">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <View
                    android:id="@+id/rangeBefore"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0" />

                <View
                    android:id="@+id/rangeFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/app_range" />

                <View
                    android:id="@+id/rangeAfter"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/highText"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/rainText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/windText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_line" />
</LinearLayout>
